# Our OAuth-gated public endpoint (SPECIFICATION.md §05)
PUBLIC_URL=http://localhost:8080
PORT=8080

# Self-issued OAuth login gate
OAUTH_USERNAME=change-me
OAUTH_PASSWORD=change-me

# S3 / Tigris, as provisioned by `fly storage create`
BUCKET_NAME=change-me
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me
AWS_ENDPOINT_URL_S3=
AWS_REGION=auto

# Upstream intervals.icu credentials (passthrough -- see vendor/intervals-icu-mcp/.env.example)
INTERVALS_ICU_API_KEY=change-me
INTERVALS_ICU_ATHLETE_ID=change-me
INTERVALS_ICU_DELETE_MODE=safe
